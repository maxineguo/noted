# Copy this file to .env and fill in your own Firebase project's config to enable cross-device
# sync (accounts, notebooks, and sharing). Leave it as-is / delete .env to keep Noted fully
# local-only (no setup required, works exactly as before).
#
# Find these values in the Firebase console: Project settings (gear icon) → General →
# "Your apps" → the web app (</>) you registered → SDK setup and configuration → Config.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
